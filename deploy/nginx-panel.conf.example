# /etc/nginx/sites-available/panel.lab.example.com
# El panel se publica como reverse proxy sobre uvicorn (127.0.0.1:9080).
# Reemplaza el server_name y las rutas del certificado por las tuyas.

server {
    listen 80;
    server_name panel.lab.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name panel.lab.example.com;

    ssl_certificate     /etc/letsencrypt/live/lab.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lab.example.com/privkey.pem;

    client_max_body_size 512m;   # subidas grandes (paquetes Duplicator, zips)

    location / {
        proxy_pass http://127.0.0.1:9080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
