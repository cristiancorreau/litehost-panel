# Copia este archivo a /etc/sw-panel/panel.env (o donde apunte PANEL_ENV_FILE)
# y rellena los valores. NUNCA subas el .env real a git.

# --- Autenticación del panel (HTTP Basic) ---
PANEL_ADMIN_USER=admin
# Hash bcrypt de la contraseña. Genéralo con:
#   python3 -c "from passlib.hash import bcrypt; print(bcrypt.hash('TU_PASSWORD'))"
PANEL_ADMIN_PASSWORD_HASH=
# Secreto de sesión (cadena larga y aleatoria):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_SESSION_SECRET=change-me

# --- Dominio base / usuario del sistema ---
# Subdominios se publican como <sub>.<PANEL_LAB_DOMAIN>
PANEL_LAB_DOMAIN=lab.example.com
# Usuario dueño de /home/<user> donde viven uploads y backups
PANEL_SYSTEM_USER=appuser

# --- MySQL / MariaDB (para crear BDs de WordPress) ---
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASS=
MYSQL_HOST=localhost

# --- PHP por defecto para sitios nuevos ---
PANEL_DEFAULT_PHP=8.3

# --- Coolify (opcional; deja el token vacío si no lo usas) ---
COOLIFY_API_URL=https://coolify.example.com/api/v1
COOLIFY_API_TOKEN=
COOLIFY_PORT_START=8101
COOLIFY_PORT_END=8200

# --- Rutas (opcionales; tienen valores por defecto sensatos) ---
# PANEL_BASE_DIR=/opt/sw-panel
# PANEL_DATA_DIR=/var/lib/sw-panel
# PANEL_WWW_ROOT=/var/www
# PANEL_NGINX_AVAILABLE=/etc/nginx/sites-available
# PANEL_NGINX_ENABLED=/etc/nginx/sites-enabled
# PANEL_SSL_CERT=/etc/letsencrypt/live/lab.example.com/fullchain.pem
# PANEL_SSL_KEY=/etc/letsencrypt/live/lab.example.com/privkey.pem
